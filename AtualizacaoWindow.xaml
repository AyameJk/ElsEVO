<Window x:Class="ElsEvo.AtualizacaoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atualização disponível"
        Width="420"
        SizeToContent="Height"
        MinHeight="220"
        Background="{DynamicResource CorFundoPrincipal}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>

        <Style x:Key="BotaoFlat" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CorBotaoFlat}"/>
            <Setter Property="Foreground" Value="{DynamicResource CorTextoPrimario}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="Background" Value="{DynamicResource CorBotaoFlatHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotaoPrimario" TargetType="Button" BasedOn="{StaticResource BotaoFlat}">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1387E8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="18">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho: ícone + título + versão -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="38" Height="38"
                    CornerRadius="19"
                    Background="#0078D4"
                    Margin="0,0,12,0">
                <TextBlock Text="&#xE896;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="18"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Atualização disponível"
                           Foreground="{DynamicResource CorTextoPrimario}"
                           FontSize="15"
                           FontWeight="Bold"/>
                <TextBlock x:Name="TxtVersaoNova"
                           Foreground="#63B3ED"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Notas da release -->
        <Border Grid.Row="1"
                x:Name="ContainerNotas"
                Background="{DynamicResource CorFundoCartao}"
                BorderBrush="{DynamicResource CorBorda}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10"
                Margin="0,0,0,10"
                MaxHeight="320">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Imagem de capa (baixada de verdade da URL do <img> nas notas —
                         não mostramos a tag HTML crua). Some sozinha se não houver
                         imagem nas notas, ou se o download falhar por qualquer motivo. -->
                    <Border x:Name="ContainerImagem"
                            CornerRadius="6"
                            ClipToBounds="True"
                            Margin="0,0,0,10"
                            MaxHeight="220"
                            Visibility="Collapsed">
                        <Image x:Name="ImgCapa" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <!-- Citação (linha que começava com "> " no Markdown original),
                         destacada em itálico com uma barrinha lateral, em vez do ">" cru. -->
                    <Border x:Name="ContainerCitacao"
                            BorderBrush="#0078D4"
                            BorderThickness="3,0,0,0"
                            Padding="10,4"
                            Margin="0,0,0,10"
                            Visibility="Collapsed">
                        <TextBlock x:Name="TxtCitacao"
                                   Foreground="{DynamicResource CorTextoPrimario}"
                                   FontSize="12"
                                   FontStyle="Italic"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock x:Name="TxtNotas"
                               Foreground="{DynamicResource CorTextoSecundario}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               LineHeight="17"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Aviso de canal beta (só aparece quando a atualização vem do canal beta) -->
        <Border Grid.Row="2"
                x:Name="ContainerAvisoBeta"
                Background="#3D2E1A"
                BorderBrush="#8A6D3B"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10"
                Margin="0,0,0,10"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="14"
                           Foreground="#F5C542"
                           VerticalAlignment="Top"
                           Margin="0,1,8,0"/>
                <TextBlock Text="Essa é uma versão BETA (canal de testes) — pode ter bugs que a versão estável não tem. Ela será instalada por cima da sua instalação atual."
                           Foreground="#E3D2A8"
                           FontSize="11"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3"
                   Text="O ElsEvo vai fechar durante a instalação e reabrir sozinho automaticamente ao terminar."
                   Foreground="{DynamicResource CorTextoSecundario}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16"/>

        <!-- Botões -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnAgoraNao"
                    Content="Agora não"
                    Width="110"
                    Style="{StaticResource BotaoFlat}"
                    Margin="0,0,8,0"
                    Click="BtnAgoraNao_Click"/>
            <Button x:Name="BtnAtualizar"
                    Content="Atualizar agora"
                    Width="140"
                    Style="{StaticResource BotaoPrimario}"
                    Click="BtnAtualizar_Click"/>
        </StackPanel>

    </Grid>

</Window>
